# Configuration de la plateforme de chatbots
# Copiez ce fichier en .env et remplissez avec vos vraies valeurs

# URL de connexion PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database

# Clé API OpenAI (obtenir sur https://platform.openai.com/account/api-keys)
OPENAI_API_KEY=sk-proj-votre-cle-api-openai-ici

# Port du serveur backend
PORT=3001

# URL du webhook n8n pour l'envoi des rapports
WEBHOOK_URL=https://n8n.srv793731.hstgr.cloud/webhook/mail-rapport

# Identifiants du compte administrateur (IMPORTANT : changez ces valeurs !)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisSecurePassword123!

# Secret JWT (optionnel, généré automatiquement si absent)
# JWT_SECRET=votre-secret-jwt-ici
